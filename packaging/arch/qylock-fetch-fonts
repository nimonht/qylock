#!/usr/bin/env bash
#
# qylock-fetch-fonts — fetch the per-theme fonts that qylock cannot ship.
#
# Several themes look their best with a specific font that we are not allowed
# to redistribute (proprietary / licensing restrictions). Upstream's README
# documents these and asks the user to drop the file into the theme's font/
# directory; this script automates that step.
#
# It can:
#   * report which themes are missing their font           (--list)
#   * install a font you already have on disk              (--install <theme> <file>)
#   * download a font from a URL you configure             (manifest / env / --url)
#   * copy a font that another theme already bundles       (handled automatically)
#
# Fonts are installed into the shared theme tree so that BOTH the SDDM greeter
# and the Quickshell lockscreen pick them up:
#     /usr/share/qylock/themes/<theme>/font/<file>
#
# Because that path is root-owned, the script elevates with sudo when needed.
#
# Licensing note: this tool never bundles or hot-links pirated fonts. Out of
# the box it only auto-installs fonts that are either (a) already present in a
# sibling theme, or (b) explicitly pointed at by YOU via the manifest, an
# environment variable, or --url/--install. You are responsible for sourcing
# each font in accordance with its license.

set -euo pipefail

# --- paths ------------------------------------------------------------------
PREFIX="${QYLOCK_PREFIX:-/usr/share/qylock}"
THEMES_ROOT="${QYLOCK_THEMES_ROOT:-$PREFIX/themes}"
SYSTEM_MANIFEST="${QYLOCK_MANIFEST:-$PREFIX/fonts.manifest}"
USER_MANIFEST="${XDG_CONFIG_HOME:-$HOME/.config}/qylock/fonts.manifest"

# --- colours ----------------------------------------------------------------
if [ -t 1 ]; then
    C_MAIN=$'\033[38;2;202;169;224m'; C_ACCENT=$'\033[38;2;145;177;240m'
    C_DIM=$'\033[38;2;129;122;150m';  C_GREEN=$'\033[38;2;166;209;137m'
    C_YELLOW=$'\033[38;2;229;200;144m'; C_RED=$'\033[38;2;231;130;132m'
    C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
    C_MAIN= C_ACCENT= C_DIM= C_GREEN= C_YELLOW= C_RED= C_BOLD= C_RESET=
fi
info()  { printf '%s\n' "${C_MAIN}${C_BOLD}::${C_RESET} $*"; }
ok()    { printf '%s\n' "  ${C_GREEN}✔${C_RESET} $*"; }
warn()  { printf '%s\n' "  ${C_YELLOW}!${C_RESET} $*"; }
err()   { printf '%s\n' "  ${C_RED}✘${C_RESET} $*" >&2; }

# --- privilege helper -------------------------------------------------------
# Run a command as root only if the theme tree is not already writable.
as_root() {
    if [ -w "$THEMES_ROOT" ]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        err "need root to write under $THEMES_ROOT and sudo is unavailable"
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Manifest format (pipe-separated, '#' comments allowed):
#   theme_relpath | dest_filename | display_name | license_note | source
#
# `source` may be:
#   (empty)                  -> no automatic source; user must supply the font
#   http(s)://...            -> downloaded with curl
#   copy:<other_theme>       -> copied from a font already present in <other_theme>
#
# Per-theme overrides (highest priority first):
#   1. --url / --install on the command line
#   2. env  QYLOCK_FONT_URL__<sanitised theme>   (e.g. QYLOCK_FONT_URL__nier_automata)
#   3. user manifest  ~/.config/qylock/fonts.manifest
#   4. system manifest $SYSTEM_MANIFEST
# ---------------------------------------------------------------------------

# Built-in fallback manifest, used if no manifest file exists on disk.
read -r -d '' BUILTIN_MANIFEST <<'EOF' || true
# theme            | filename               | display name      | license note                              | source
nier-automata      | FOT-Rodin Pro DB.otf   | FOT-Rodin Pro DB  | proprietary (Fontworks) — supply your own |
terraria           | Andy Bold.ttf          | Andy Bold         | proprietary (Monotype) — supply your own  |
Genshin            | zhcn.ttf               | HYWenHei-85W      | proprietary (Hanyi) — supply your own     |
minecraft          | minecraft.ttf          | Minecraft Regular | free for personal use — supply your own   |
star-rail          | font.ttf               | DIN Next          | proprietary (Linotype) — supply your own  |
windows_7          | segoeui.ttf            | Segoe UI          | proprietary (Microsoft) — supply your own |
osumania           | Torus Regular.otf      | Torus Regular     | copied from the osu! theme                | copy:osu
EOF

env_key() { printf 'QYLOCK_FONT_URL__%s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_')"; }

# Read manifest lines (user manifest overrides system; falls back to built-in).
manifest_lines() {
    if [ -f "$USER_MANIFEST" ]; then cat "$USER_MANIFEST"; fi
    if [ -f "$SYSTEM_MANIFEST" ]; then
        cat "$SYSTEM_MANIFEST"
    else
        printf '%s\n' "$BUILTIN_MANIFEST"
    fi
}

# Parse a single manifest row into the global FIELD_* vars. Returns 1 on skip.
parse_row() {
    local line="$1"
    line="${line%%#*}"
    [ -n "${line//[[:space:]]/}" ] || return 1
    IFS='|' read -r FIELD_THEME FIELD_FILE FIELD_NAME FIELD_LICENSE FIELD_SRC <<<"$line"
    FIELD_THEME="$(printf '%s' "${FIELD_THEME:-}" | xargs)"
    FIELD_FILE="$(printf '%s' "${FIELD_FILE:-}"   | xargs)"
    FIELD_NAME="$(printf '%s' "${FIELD_NAME:-}"   | sed 's/^ *//;s/ *$//')"
    FIELD_LICENSE="$(printf '%s' "${FIELD_LICENSE:-}" | sed 's/^ *//;s/ *$//')"
    FIELD_SRC="$(printf '%s' "${FIELD_SRC:-}" | xargs)"
    [ -n "$FIELD_THEME" ] && [ -n "$FIELD_FILE" ]
}

# Is a (ttf/otf) font already installed for a theme?
has_font() {
    local dir="$THEMES_ROOT/$1/font"
    [ -d "$dir" ] || return 1
    compgen -G "$dir/*.ttf" >/dev/null 2>&1 || compgen -G "$dir/*.otf" >/dev/null 2>&1
}

# Install a file from $1 into the theme $2 as $3.
install_file() {
    local srcfile="$1" theme="$2" destname="$3"
    local destdir="$THEMES_ROOT/$theme/font"
    as_root mkdir -p "$destdir"
    as_root install -m 0644 "$srcfile" "$destdir/$destname"
    ok "installed ${C_ACCENT}$destname${C_RESET} → $theme/font/"
}

# Resolve the effective source for a theme (env > manifest field).
resolve_src() {
    local theme="$1" manifest_src="$2"
    local key; key="$(env_key "$theme")"
    if [ -n "${!key:-}" ]; then printf '%s' "${!key}"; else printf '%s' "$manifest_src"; fi
}

# Fetch one theme's font according to its source. Returns 0 if installed.
fetch_one() {
    local theme="$1" file="$2" name="$3" license="$4" src="$5"

    if has_font "$theme"; then
        ok "$theme already has a font — skipping"
        return 0
    fi

    src="$(resolve_src "$theme" "$src")"

    case "$src" in
        copy:*)
            local from="${src#copy:}"
            local fontdir="$THEMES_ROOT/$from/font" found=""
            found="$(find "$fontdir" -maxdepth 1 \( -name '*.ttf' -o -name '*.otf' \) 2>/dev/null | head -n1)"
            if [ -n "$found" ]; then
                install_file "$found" "$theme" "$file"
            else
                warn "$theme: source theme '$from' has no font yet (fetch it first)"
                return 1
            fi
            ;;
        http://*|https://*)
            command -v curl >/dev/null || { err "curl not installed (pacman -S curl)"; return 1; }
            local tmp; tmp="$(mktemp)"
            info "$theme: downloading ${C_ACCENT}$name${C_RESET}"
            if curl -fL --retry 3 -o "$tmp" "$src"; then
                install_file "$tmp" "$theme" "$file"
                rm -f "$tmp"
            else
                rm -f "$tmp"
                err "$theme: download failed ($src)"
                return 1
            fi
            ;;
        "")
            warn "$theme needs ${C_ACCENT}$name${C_RESET} (${file})"
            printf '      %s\n' "${C_DIM}license: ${license:-unknown}${C_RESET}"
            printf '      %s\n' "${C_DIM}supply it with:${C_RESET}"
            printf '      %s\n' "  qylock-fetch-fonts --install $theme /path/to/your/font.${file##*.}"
            printf '      %s\n' "${C_DIM}or set a URL:${C_RESET} $(env_key "$theme")=https://… qylock-fetch-fonts"
            return 1
            ;;
        *)
            err "$theme: unrecognised source '$src'"
            return 1
            ;;
    esac
}

# --- subcommands ------------------------------------------------------------
do_list() {
    info "qylock font status (themes root: $THEMES_ROOT)"
    local any=0
    while IFS= read -r line; do
        parse_row "$line" || continue
        any=1
        if has_font "$FIELD_THEME"; then
            ok "$FIELD_THEME — ${C_DIM}installed${C_RESET}"
        else
            warn "$FIELD_THEME — needs ${C_ACCENT}$FIELD_NAME${C_RESET} ($FIELD_FILE)"
        fi
    done < <(manifest_lines)
    [ "$any" = 1 ] || warn "no manifest entries found"
}

do_fetch() {
    local only="${1:-}" rc=0
    info "fetching missing fonts"
    while IFS= read -r line; do
        parse_row "$line" || continue
        [ -z "$only" ] || [ "$only" = "$FIELD_THEME" ] || continue
        fetch_one "$FIELD_THEME" "$FIELD_FILE" "$FIELD_NAME" "$FIELD_LICENSE" "$FIELD_SRC" || rc=1
    done < <(manifest_lines)
    [ "$rc" -eq 0 ] && info "${C_GREEN}all done${C_RESET}" || info "some fonts still need to be supplied (see above)"
    return 0
}

do_install() {
    local theme="$1" file="$2"
    [ -f "$file" ] || { err "no such file: $file"; exit 1; }
    [ -d "$THEMES_ROOT/$theme" ] || { err "no such theme: $theme"; exit 1; }
    # keep the manifest's preferred filename if we have one, else reuse the source name
    local destname; destname="$(basename "$file")"
    while IFS= read -r line; do
        parse_row "$line" || continue
        if [ "$FIELD_THEME" = "$theme" ]; then destname="$FIELD_FILE"; break; fi
    done < <(manifest_lines)
    install_file "$file" "$theme" "$destname"
}

usage() {
    cat <<EOF
qylock-fetch-fonts — fetch per-theme fonts qylock cannot ship

Usage:
  qylock-fetch-fonts                 fetch every missing font it can
  qylock-fetch-fonts <theme>         fetch the font for one theme
  qylock-fetch-fonts --list          show which themes still need a font
  qylock-fetch-fonts --install <theme> <file>
                                     install a font you already have
  qylock-fetch-fonts --url <theme> <url>
                                     fetch one theme's font from a URL

Manifest : $SYSTEM_MANIFEST  (override per-user in $USER_MANIFEST)
Env URLs : QYLOCK_FONT_URL__<theme>   e.g. QYLOCK_FONT_URL__nier_automata=https://…
EOF
}

# --- dispatch ---------------------------------------------------------------
[ -d "$THEMES_ROOT" ] || { err "themes root not found: $THEMES_ROOT (is qylock installed?)"; exit 1; }

case "${1:-}" in
    -h|--help)    usage ;;
    --list|-l)    do_list ;;
    --install|-i) shift; [ $# -eq 2 ] || { usage; exit 1; }; do_install "$1" "$2" ;;
    --url|-u)     shift; [ $# -eq 2 ] || { usage; exit 1; }
                  key="$(env_key "$1")"; export "$key=$2"; do_fetch "$1" ;;
    "")           do_fetch ;;
    -*)           err "unknown option: $1"; usage; exit 1 ;;
    *)            do_fetch "$1" ;;
esac
