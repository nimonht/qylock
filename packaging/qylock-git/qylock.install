post_install() {
    cat <<'MSG'
==> qylock installed.

    Activate an SDDM login theme:
        qylock-sddm list
        qylock-sddm set nier-automata

    Use the Quickshell lockscreen (bind in your WM):
        qylock-lock                 # default / saved theme
        qylock-lock clockwork/tape  # a specific theme

    Some themes need a font that cannot be shipped (licensing). Fetch/supply:
        qylock-fetch-fonts --list
        qylock-fetch-fonts --install nier-automata "/path/to/FOT-Rodin Pro DB.otf"

    Optional runtime deps for video wallpapers:
        qt6-multimedia-ffmpeg  gst-plugins-{base,good,bad,ugly}
MSG
}

post_upgrade() {
    post_install
}

post_remove() {
    # pacman removes everything the package owned. Clean up the bits that are
    # created AFTER install and are therefore untracked.

    # 1. Fonts fetched by qylock-fetch-fonts live under the (now-removed) tree.
    if [ -d /usr/share/qylock ]; then
        rm -rf /usr/share/qylock
    fi

    # 2. qylock's dedicated SDDM drop-in (written by `qylock-sddm set`).
    if [ -f /etc/sddm.conf.d/zz-qylock.conf ]; then
        rm -f /etc/sddm.conf.d/zz-qylock.conf
        echo "==> Removed /etc/sddm.conf.d/zz-qylock.conf (SDDM back to default theme)."
    fi

    cat <<'MSG'
==> qylock removed.
    Per-user state (if any) was left untouched. Remove it with:
        rm -rf ~/.config/qylock
MSG
}
