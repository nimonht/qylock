#!/usr/bin/env bash
#
# qylock-lock — launch the qylock Quickshell lockscreen.
#
# Bind this to a key in your WM (e.g. Hyprland: bind = SUPER, L, exec, qylock-lock).
# Pass a theme name as $1 to override on the fly:  qylock-lock clockwork/tape
#
# Theme is chosen in this order: $1  >  ~/.config/qylock/theme  >  nier-automata

set -euo pipefail

PREFIX="${QYLOCK_PREFIX:-/usr/share/qylock}"
THEMES_ROOT="${QYLOCK_THEMES_ROOT:-$PREFIX/themes}"
QS_DIR="$PREFIX/quickshell"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/qylock/theme"

if [ -n "${1:-}" ]; then
    QS_THEME="$1"
elif [ -f "$CONFIG_FILE" ]; then
    QS_THEME="$(cat "$CONFIG_FILE")"
else
    QS_THEME="nier-automata"
fi

export QS_THEME
export QS_THEME_PATH="$THEMES_ROOT/$QS_THEME"
export QML2_IMPORT_PATH="$QS_DIR/imports${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export QML_XHR_ALLOW_FILE_READ=1
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"

if ! command -v quickshell >/dev/null 2>&1; then
    echo "qylock: quickshell is not installed (try: pacman -S quickshell)" >&2
    exit 1
fi

if [ ! -d "$QS_THEME_PATH" ]; then
    echo "qylock: theme '$QS_THEME' not found at $QS_THEME_PATH" >&2
    echo "        available themes:" >&2
    find "$THEMES_ROOT" -name metadata.desktop -printf '          %h\n' 2>/dev/null \
        | sed "s|$THEMES_ROOT/||" >&2
    exit 1
fi

echo "Locking with Quickshell — theme: $QS_THEME"
echo "Theme path: $QS_THEME_PATH"

# Drop any other locker that may already own the session.
killall -9 hyprlock swaylock wlogout 2>/dev/null || true

exec quickshell -p "$QS_DIR/lock_shell.qml"
