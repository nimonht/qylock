#!/usr/bin/env bash
#
# qylock-sddm — choose / list / reset the active qylock SDDM login theme.
#
# All qylock themes are installed as SDDM themes named  qylock-<theme>  under
# /usr/share/sddm/themes. This helper sets the active one by writing a single,
# dedicated drop-in:
#
#     /etc/sddm.conf.d/zz-qylock.conf
#
# Using our own drop-in (instead of editing a shared theme.conf) means the
# package can undo every change it made simply by deleting this one file — no
# leftovers, no clobbering of settings you wrote yourself.

set -euo pipefail

SDDM_THEMES_DIR="/usr/share/sddm/themes"
CONF_DIR="/etc/sddm.conf.d"
CONF="$CONF_DIR/zz-qylock.conf"
PREFIX="${QYLOCK_PREFIX:-/usr/share/qylock}"

if [ -t 1 ]; then
    C_ACCENT=$'\033[38;2;145;177;240m'; C_GREEN=$'\033[38;2;166;209;137m'
    C_YELLOW=$'\033[38;2;229;200;144m'; C_DIM=$'\033[38;2;129;122;150m'
    C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
    C_ACCENT= C_GREEN= C_YELLOW= C_DIM= C_BOLD= C_RESET=
fi

as_root() {
    if [ "$(id -u)" -eq 0 ]; then "$@"
    elif command -v sudo >/dev/null 2>&1; then sudo "$@"
    else echo "qylock-sddm: this action needs root and sudo is unavailable" >&2; exit 1; fi
}

# Map a user-given name to an installed sddm theme dir name.
# Accepts "nier-automata", "qylock-nier-automata" or "clockwork/orbital".
resolve_theme() {
    local name="$1"
    name="${name##*/}"                 # clockwork/orbital -> orbital
    case "$name" in
        qylock-*) printf '%s' "$name" ;;
        *)        printf 'qylock-%s' "$name" ;;
    esac
}

list_themes() {
    echo "${C_BOLD}Installed qylock SDDM themes:${C_RESET}"
    local cur=""
    [ -f "$CONF" ] && cur="$(sed -n 's/^Current=//p' "$CONF" | tail -n1)"
    for d in "$SDDM_THEMES_DIR"/qylock-*; do
        [ -d "$d" ] || continue
        local b; b="$(basename "$d")"
        if [ "$b" = "$cur" ]; then
            printf '  %s● %s%s %s(active)%s\n' "$C_GREEN" "$b" "$C_RESET" "$C_DIM" "$C_RESET"
        else
            printf '  %s○%s %s\n' "$C_DIM" "$C_RESET" "$b"
        fi
    done
}

set_theme() {
    local theme; theme="$(resolve_theme "$1")"
    if [ ! -d "$SDDM_THEMES_DIR/$theme" ]; then
        echo "qylock-sddm: no such theme '$theme' in $SDDM_THEMES_DIR" >&2
        echo "Run 'qylock-sddm list' to see what's available." >&2
        exit 1
    fi
    as_root mkdir -p "$CONF_DIR"
    printf '[Theme]\nCurrent=%s\n' "$theme" | as_root tee "$CONF" >/dev/null
    echo "${C_GREEN}✔${C_RESET} Active SDDM theme set to ${C_ACCENT}$theme${C_RESET}"
    echo "${C_DIM}  (written to $CONF — restart SDDM or reboot to see it)${C_RESET}"
}

reset_theme() {
    if [ -f "$CONF" ]; then
        as_root rm -f "$CONF"
        echo "${C_GREEN}✔${C_RESET} Removed $CONF — SDDM falls back to its default theme."
    else
        echo "${C_YELLOW}!${C_RESET} Nothing to reset ($CONF does not exist)."
    fi
}

usage() {
    cat <<EOF
qylock-sddm — manage the active qylock SDDM login theme

Usage:
  qylock-sddm list             list installed qylock SDDM themes
  qylock-sddm set <theme>      make <theme> the active login screen
  qylock-sddm reset            remove qylock's SDDM override (clean default)

Examples:
  qylock-sddm set nier-automata
  qylock-sddm set clockwork/orbital
EOF
}

case "${1:-list}" in
    list|ls|-l)        list_themes ;;
    set|use)           shift; [ $# -ge 1 ] || { usage; exit 1; }; set_theme "$1" ;;
    reset|unset|clear) reset_theme ;;
    -h|--help|help)    usage ;;
    *)                 echo "qylock-sddm: unknown command '$1'" >&2; usage; exit 1 ;;
esac
